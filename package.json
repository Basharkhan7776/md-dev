{
  "name": "md-dev",
  "version": "1.0.6",
  "description": "CLI Markdown viewer — Vercel Geist theme, Mermaid, live reload on localhost",
  "type": "module",
  "bin": {
    "md-dev": "bin/md-dev"
  },
  "main": "./dist/cli.js",
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run build:web && bun run src/cli.ts fixtures/sample.md --no-open",
    "build": "bun run scripts/build.ts",
    "build:web": "bun run scripts/build-web.ts",
    "start": "bun run src/cli.ts",
    "md-dev": "bun run src/cli.ts",
    "preview": "bun run build && bun run src/cli.ts fixtures/sample.md",
    "prepublishOnly": "bun run build",
    "link:local": "bun run build && bun link"
  },
  "keywords": [
    "markdown",
    "cli",
    "viewer",
    "bun",
    "mermaid",
    "geist",
    "preview",
    "gfm"
  ],
  "author": "basharkhan7776",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basharkhan7776/mdparse.git"
  },
  "bugs": {
    "url": "https://github.com/basharkhan7776/mdparse/issues"
  },
  "homepage": "https://github.com/basharkhan7776/mdparse#readme",
  "engines": {
    "bun": ">=1.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.28.0",
    "mermaid": "^11.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.2.0"
  }
}
